{
  "name": "shiftle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A round block puzzle. Fill a ring, spin a ring.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "play": "node tools/play.mjs",
    "shoot": "node tools/shoot.mjs",
    "balance": "vite-node tools/balance.ts",
    "experiment": "vite-node tools/experiment.ts",
    "economy": "vite-node tools/economy.ts",
    "fairness": "vite-node tools/fairness.ts",
    "ios:sync": "vite build && cap sync ios && node tools/verify-ios.mjs",
    "ios:assets": "node tools/assets.mjs && npx @capacitor/assets generate --ios",
    "endless": "vite-node tools/endless.ts",
    "verify:ios": "node tools/verify-ios.mjs",
    "audio": "node tools/audio-preview.mjs"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3"
  }
}
